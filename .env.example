# Microsoft Fabric configuration for the bundled scripts.
# Copy to .env and fill in. NEVER commit the filled file — .env is gitignored.
# Environment variables always override this file, so the same code runs in CI.
#
# Define each key exactly ONCE. The parsers use setdefault, so the first
# occurrence wins and an empty duplicate silently overrides a filled one.

# --- Azure app registration (service principal) ---
# Use the tenant GUID, not "organizations" or "common" — those are invalid for
# the client-credentials grant.
AZURE_TENANT=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# --- Fabric target ---
# GUIDs are preferred over names: stable across renames, and with GUIDs the
# abfss path takes NO ".Lakehouse" suffix.
FABRIC_WORKSPACE=00000000-0000-0000-0000-000000000000
FABRIC_LAKEHOUSE=00000000-0000-0000-0000-000000000000

# Schema-enabled lakehouse only. Leave EMPTY for a classic (flat) lakehouse,
# where the path is Tables/<table> with no schema segment.
FABRIC_SCHEMA=

# Table to read in the probe. Empty = first table discovered.
FABRIC_TABLE=

# --- SQL analytics endpoint / Warehouse ---
# The FQDN is a generated string and cannot be guessed. Leave empty and the
# probe discovers it from the Fabric REST API.
# One workspace = one server; Lakehouse endpoints and Warehouses are separate
# databases on it. FABRIC_SQL_DB is the item DISPLAY NAME, not its GUID.
FABRIC_SQL_SERVER=
FABRIC_SQL_DB=

# Comma-separated databases for inventory_schemas.py
FABRIC_DATABASES=

# --- Optional overrides ---
# Sovereign clouds use different hosts; never hardcode these in code.
# ONELAKE_DFS_HOST=onelake.dfs.fabric.microsoft.com
# FABRIC_API_HOST=https://api.fabric.microsoft.com
# AZURE_LOGIN_HOST=https://login.microsoftonline.com
# SQLCMD_PATH=/path/to/sqlcmd
# FABRIC_TIMEOUT=30
